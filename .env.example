# Orin MCP — environment template. NEVER commit real values.

# Orin backend base (default https://orinai.org). Override to point the MCP
# server at Orin Router or a self-hosted backend with the same compat shape.
ORIN_API=https://orinai.org

# Per-token requests/minute on state-changing tools (default 60).
ORIN_MCP_PER_MIN=

# Request timeout to the model backend, ms (default 120000).
ORIN_MCP_TIMEOUT_MS=
