{
  "name": "orin-mcp",
  "version": "1.1.0",
  "description": "Orin models through hosted Streamable HTTP and local stdio MCP transports.",
  "type": "module",
  "bin": { "orin-mcp": "./dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "platform:build": "npm --prefix vendor/orin-platform ci && npm --prefix vendor/orin-platform run build",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "npm run build && node --test --import ./test/_hooks.mjs test/*.test.mjs",
    "test:stdio": "npm run build && node --test test/stdio.test.mjs",
    "test:package": "npm run build && npm pack --dry-run",
    "check": "npm run platform:build && npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@orin/contracts": "file:vendor/orin-platform/packages/contracts"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "typescript": "5.9.3"
  }
}
